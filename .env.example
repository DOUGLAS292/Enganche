# Cadena de conexión a PostgreSQL con PostGIS habilitado.
# Recomendado para el piloto: Supabase → Project Settings → Database → Connection string → URI.
DATABASE_URL=postgres://usuario:password@host:5432/postgres

NEXT_PUBLIC_APP_NAME=Enganche

# Fase 1 — Auth por OTP
# Secreto para firmar sesiones y códigos OTP (nunca lo compartas ni lo subas a git).
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# WhatsApp Business Cloud API (Meta) — opcional mientras se gestiona y aprueba
# la plantilla de autenticación. Sin estas variables, el código OTP se imprime
# en la consola del servidor (y viaja en la respuesta de /api/auth/otp/solicitar)
# para poder probar el flujo completo sin WhatsApp real. Ver README § Fase 1.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANG=es

# Mantenimiento diario de publicaciones (ver vercel.json) — avisos por
# WhatsApp. Requieren plantillas aprobadas en Meta Business Manager de
# categoría "Utility" (distinta de la de autenticación). Sin estas
# variables, cada aviso solo se registra en la consola del servidor.
# "Por expirar" (2 variables: nombre del proyecto, días sin postulantes):
WHATSAPP_AVISO_EXPIRACION_TEMPLATE=
WHATSAPP_AVISO_EXPIRACION_TEMPLATE_LANG=es
# "Postulantes esperando" (3 variables: nombre del proyecto, días
# esperando, cantidad de postulantes pendientes):
WHATSAPP_AVISO_POSTULANTES_TEMPLATE=
WHATSAPP_AVISO_POSTULANTES_TEMPLATE_LANG=es
# "Comisión pendiente" (2 variables: nombre del proyecto, monto a pagar) —
# se envía al ganador cuando el autor marca el trabajo como completado:
WHATSAPP_AVISO_COMISION_PENDIENTE_TEMPLATE=
WHATSAPP_AVISO_COMISION_PENDIENTE_TEMPLATE_LANG=es
# "Comisión rechazada" (2 variables: nombre del proyecto, monto) — se
# envía cuando el admin rechaza un pago marcado como pagado:
WHATSAPP_AVISO_COMISION_RECHAZADA_TEMPLATE=
WHATSAPP_AVISO_COMISION_RECHAZADA_TEMPLATE_LANG=es
# "Urgente": 3 plantillas del ciclo completo —
# (1) al admin cuando el autor solicita activarlo (2 variables: proyecto, monto):
WHATSAPP_AVISO_SOLICITUD_URGENTE_TEMPLATE=
WHATSAPP_AVISO_SOLICITUD_URGENTE_TEMPLATE_LANG=es
# (2) al autor cuando el admin confirma el pago (1 variable: proyecto):
WHATSAPP_AVISO_URGENTE_CONFIRMADO_TEMPLATE=
WHATSAPP_AVISO_URGENTE_CONFIRMADO_TEMPLATE_LANG=es
# (3) a los postulantes cercanos que califican, apenas se confirma (2
# variables: proyecto, ciudad):
WHATSAPP_AVISO_OFERTA_URGENTE_TEMPLATE=
WHATSAPP_AVISO_OFERTA_URGENTE_TEMPLATE_LANG=es

# Secreto compartido para que solo Vercel pueda disparar el cron de
# expiración (Vercel lo envía solo si defines esta misma variable en el
# proyecto — ver vercel.json). Genera uno igual que AUTH_SECRET.
CRON_SECRET=

# Foto de perfil — sube directo al bucket "avatares" de Supabase Storage.
# SUPABASE_ANON_KEY es la llave "anon" pública del proyecto (Project
# Settings → API), no es secreta — no confundir con la service_role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
