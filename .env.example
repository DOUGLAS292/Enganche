# Cadena de conexión a PostgreSQL con PostGIS habilitado.
# Recomendado para el piloto: Supabase → Project Settings → Database → Connection string → URI.
DATABASE_URL=postgres://usuario:password@host:5432/postgres

NEXT_PUBLIC_APP_NAME=Enganche

# Fase 1 — Auth por OTP
# Secreto para firmar sesiones y códigos OTP (nunca lo compartas ni lo subas a git).
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# WhatsApp Business Cloud API (Meta) — opcional mientras se gestiona y aprueba
# la plantilla de autenticación. Sin estas variables, el código OTP se imprime
# en la consola del servidor (y viaja en la respuesta de /api/auth/otp/solicitar)
# para poder probar el flujo completo sin WhatsApp real. Ver README § Fase 1.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_TEMPLATE_LANG=es
